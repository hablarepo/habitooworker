# Zkopíruj do ".env" (je v .gitignore) a doplň hodnoty. NIKDY necommituj .env.
# Service role key najdeš v Supabase: Project Settings -> API -> service_role.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Režim: "real" (COLMAP + gsplat, vyžaduje GPU) nebo "synthetic" (test bez GPU)
WORKER_MODE=real

# [DOPLNIT] – bez těchto hodnot worker v režimu "real" nenastartuje
JOB_TIMEOUT_S=
VIDEO_RETENTION_DAYS=
VIDEO_BUCKET=
MODEL_BUCKET=

# Volitelné (výchozí hodnoty viz src/habitoo_worker/config.py)
# SCAN_JOBS_TABLE=scan_jobs
# POLL_INTERVAL_S=10
# MAX_ATTEMPTS=2
# WORK_DIR=/work
# TARGET_FRAMES=150
# MIN_FRAMES=30
# MAX_IMAGE_SIDE=960
# MAX_GAUSSIANS=600000
# TRAIN_STEPS=7000
